{% comment %}
  Image or a quiet placeholder. The parent frame sets the aspect ratio.

  Accepts:
  image, widths, sizes, loading, fetchpriority, position
{% endcomment %}
{%- liquid
  assign media_loading = loading | default: 'lazy'
  assign media_widths = widths | default: '600, 900, 1200, 1600'
  assign media_sizes = sizes | default: '(min-width: 900px) 40vw, 92vw'
  assign media_position = position | default: 'center'
-%}
<div class="about-media" style="--about-pos: {{ media_position }};">
  {%- if image != blank -%}
    {%- assign media_alt = image.alt | default: '' -%}
    {%- if fetchpriority == 'high' -%}
      {{
        image
        | image_url: width: 2000
        | image_tag:
          class: 'about-media__img',
          widths: media_widths,
          sizes: media_sizes,
          loading: media_loading,
          fetchpriority: 'high',
          alt: media_alt
      }}
    {%- else -%}
      {{
        image
        | image_url: width: 2000
        | image_tag:
          class: 'about-media__img',
          widths: media_widths,
          sizes: media_sizes,
          loading: media_loading,
          alt: media_alt
      }}
    {%- endif -%}
  {%- else -%}
    <div class="about-media__placeholder" aria-hidden="true">
      <span>Add image</span>
    </div>
  {%- endif -%}
</div>

{% render 'contact-assets' %}

{%- liquid
  assign form_id = 'ContactForm-' | append: section.id
  assign reasons = section.settings.reasons | newline_to_br | replace: '<br />', '|' | replace: '<br>', '|' | split: '|'
-%}

<section class="contact-talk full-width" aria-labelledby="ContactTalk-{{ section.id }}">
  <div class="contact-talk__layout">
    <div class="contact-talk__intro" data-contact-watch>
      {%- if section.settings.heading != blank -%}
        <h2 class="contact-talk__heading" id="ContactTalk-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.copy != blank -%}
        <p class="contact-talk__copy">{{ section.settings.copy | escape }}</p>
      {%- endif -%}
      {%- if section.settings.note != blank -%}
        <p class="contact-talk__note">{{ section.settings.note | escape }}</p>
      {%- endif -%}
    </div>

    <div class="contact-talk__form">
      {% form 'contact', id: form_id %}
        {%- if form.posted_successfully? -%}
          <div class="contact-success" role="status" tabindex="-1" data-contact-watch>
            <p class="contact-success__title">{{ section.settings.success_heading | escape }}</p>
            {%- if section.settings.success_copy != blank -%}
              <p class="contact-success__copy">{{ section.settings.success_copy | escape }}</p>
            {%- endif -%}
          </div>
        {%- else -%}
          {%- if form.errors -%}
            <div class="contact-alert" role="alert" tabindex="-1" autofocus>
              <p class="contact-alert__title">Please check the following:</p>
              <ul class="contact-alert__list">
                {%- for field in form.errors -%}
                  <li>
                    {%- if field == 'form' -%}
                      {{ form.errors.messages[field] }}
                    {%- else -%}
                      <a href="#{{ form_id }}-{{ field }}">
                        {{ form.errors.translated_fields[field] | capitalize }}
                        {{ form.errors.messages[field] }}
                      </a>
                    {%- endif -%}
                  </li>
                {%- endfor -%}
              </ul>
            </div>
          {%- endif -%}

          <div class="contact-fields">
            <div class="contact-fields__pair">
              <div class="contact-field">
                <label class="contact-field__label" for="{{ form_id }}-name">First name</label>
                <input
                  class="contact-field__input"
                  id="{{ form_id }}-name"
                  type="text"
                  name="contact[name]"
                  autocomplete="given-name"
                  required
                  {% if form.name %}value="{{ form.name }}"{% elsif customer %}value="{{ customer.first_name }}"{% endif %}
                >
              </div>
              <div class="contact-field">
                <label class="contact-field__label" for="{{ form_id }}-last">Last name</label>
                <input
                  class="contact-field__input"
                  id="{{ form_id }}-last"
                  type="text"
                  name="contact[Last name]"
                  autocomplete="family-name"
                  required
                  {% if customer %}value="{{ customer.last_name }}"{% endif %}
                >
              </div>
            </div>

            <div class="contact-field">
              <label class="contact-field__label" for="{{ form_id }}-email">Email</label>
              <input
                class="contact-field__input"
                id="{{ form_id }}-email"
                type="email"
                name="contact[email]"
                autocomplete="email"
                spellcheck="false"
                autocapitalize="off"
                required
                aria-invalid="{% if form.errors contains 'email' %}true{% else %}false{% endif %}"
                {% if form.errors contains 'email' %}aria-describedby="{{ form_id }}-email-error"{% endif %}
                {% if form.email %}value="{{ form.email }}"{% elsif customer %}value="{{ customer.email }}"{% endif %}
              >
              {%- if form.errors contains 'email' -%}
                <p class="contact-field__error" id="{{ form_id }}-email-error">
                  {{ form.errors.translated_fields.email | capitalize }}
                  {{ form.errors.messages.email }}
                </p>
              {%- endif -%}
            </div>

            <div class="contact-field">
              <label class="contact-field__label" for="{{ form_id }}-order">Order number <span class="contact-field__optional">(optional)</span></label>
              <input
                class="contact-field__input"
                id="{{ form_id }}-order"
                type="text"
                name="contact[Order number]"
                autocomplete="off"
              >
            </div>

            <div class="contact-field">
              <label class="contact-field__label" for="{{ form_id }}-reason">Reason for contacting</label>
              <div class="contact-field__select">
                <select class="contact-field__input" id="{{ form_id }}-reason" name="contact[Reason]" required>
                  <option value="" selected disabled>Choose a reason</option>
                  {%- for reason in reasons -%}
                    {%- assign clean_reason = reason | strip -%}
                    {%- if clean_reason != blank -%}
                      <option value="{{ clean_reason | escape }}">{{ clean_reason | escape }}</option>
                    {%- endif -%}
                  {%- endfor -%}
                </select>
              </div>
            </div>

            <div class="contact-field">
              <label class="contact-field__label" for="{{ form_id }}-body">Message</label>
              <textarea
                class="contact-field__input contact-field__input--area"
                id="{{ form_id }}-body"
                name="contact[body]"
                rows="5"
                required
              >{%- if form.body -%}{{ form.body }}{%- endif -%}</textarea>
            </div>
          </div>

          <button class="contact-submit" type="submit">
            {{ section.settings.button_label | escape }}
            <span class="contact-submit__arrow" aria-hidden="true">&rarr;</span>
          </button>
        {%- endif -%}
      {% endform %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Contact form",
  "tag": "div",
  "class": "section-contact",
  "enabled_on": { "templates": ["page"] },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "How can we help?"
    },
    {
      "type": "textarea",
      "id": "copy",
      "label": "Supporting text",
      "default": "Share a little about what you need. A real person will read it."
    },
    {
      "type": "text",
      "id": "note",
      "label": "Small note",
      "info": "Optional. Leave empty to hide."
    },
    {
      "type": "textarea",
      "id": "reasons",
      "label": "Reasons",
      "info": "One reason per row.",
      "default": "Product question\nOrder support\nShipping & delivery\nReturns & refunds\nSkincare guidance\nWholesale / partnership\nPress / media\nOther"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Send message"
    },
    {
      "type": "text",
      "id": "success_heading",
      "label": "Success heading",
      "default": "Thank you."
    },
    {
      "type": "textarea",
      "id": "success_copy",
      "label": "Success text",
      "default": "Your message has reached us. We'll be in touch soon."
    }
  ],
  "presets": [
    { "name": "Contact form" }
  ]
}
{% endschema %}

{% render 'contact-assets' %}

{%- liquid
  assign image_position = section.settings.image_position | default: 'center'
-%}

<section class="contact-hero full-width">
  <div class="contact-hero__layout">
    <div class="contact-hero__copy">
      {%- if section.settings.eyebrow != blank -%}
        <p class="contact-kicker contact-hero__kicker">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      <h1 class="contact-hero__heading contact-hero__title">
        {{ section.settings.heading | escape }}
        {%- if section.settings.heading_emphasis != blank -%}
          <span class="contact-hero__emphasis">{{ section.settings.heading_emphasis | escape }}</span>
        {%- endif -%}
      </h1>
      {%- if section.settings.copy != blank -%}
        <p class="contact-hero__support">{{ section.settings.copy | escape }}</p>
      {%- endif -%}
    </div>
    <div class="contact-hero__frame">
      {% render 'contact-media',
        image: section.settings.image,
        fallback: 'contact-hero.jpg',
        fallback_alt: 'A blank notebook, cup, and bottle on a wooden table',
        widths: '750, 1100, 1500, 2000',
        sizes: '(min-width: 900px) 52vw, 100vw',
        loading: 'eager',
        fetchpriority: 'high',
        position: image_position
      %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Contact hero",
  "tag": "div",
  "class": "section-contact",
  "enabled_on": { "templates": ["page"] },
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "Leave empty to show the placeholder."
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "default": "center",
      "options": [
        { "value": "center", "label": "Center" },
        { "value": "center top", "label": "Top" },
        { "value": "center 35%", "label": "Slightly above center" },
        { "value": "center bottom", "label": "Bottom" }
      ]
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Get in touch"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Let's talk"
    },
    {
      "type": "text",
      "id": "heading_emphasis",
      "label": "Heading, italic",
      "default": "skincare."
    },
    {
      "type": "textarea",
      "id": "copy",
      "label": "Supporting text",
      "default": "Questions, thoughts, or simply looking for the right ritual? We're here."
    }
  ],
  "presets": [
    { "name": "Contact hero" }
  ]
}
{% endschema %}

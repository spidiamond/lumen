{% render 'about-assets' %}

{%- liquid
  assign image_position = section.settings.image_position | default: 'center'
-%}

<section
  class="about-hero full-width{% if section.settings.image == blank %} is-empty{% endif %}"
>
  <div class="about-hero__frame">
    <div class="about-hero__media">
      {% render 'about-media',
        image: section.settings.image,
        widths: '750, 1100, 1600, 2000, 2400',
        sizes: '100vw',
        loading: 'eager',
        fetchpriority: 'high',
        position: image_position
      %}
    </div>
    <div class="about-hero__content" data-align="{{ section.settings.alignment }}">
      <div class="about-hero__title">
        {%- if section.settings.eyebrow != blank -%}
          <p class="about-kicker">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        <h1 class="about-hero__heading">
          {{ section.settings.heading | escape }}
          {%- if section.settings.heading_emphasis != blank -%}
            <span class="about-hero__emphasis">{{ section.settings.heading_emphasis | escape }}</span>
          {%- endif -%}
        </h1>
      </div>
      {%- if section.settings.copy != blank -%}
        <p class="about-hero__copy">{{ section.settings.copy | escape }}</p>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "About hero",
  "tag": "div",
  "class": "section-about",
  "enabled_on": { "templates": ["page"] },
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "Leave empty to show the placeholder."
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "default": "center",
      "options": [
        { "value": "center", "label": "Center" },
        { "value": "center top", "label": "Top" },
        { "value": "center 35%", "label": "Slightly above center" },
        { "value": "center bottom", "label": "Bottom" }
      ]
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "About Lūmen"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Skincare,"
    },
    {
      "type": "text",
      "id": "heading_emphasis",
      "label": "Heading, italic",
      "default": "illuminated."
    },
    {
      "type": "textarea",
      "id": "copy",
      "label": "Supporting text",
      "default": "Thoughtful formulas for skin that looks, feels, and lives beautifully."
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Text alignment",
      "default": "left",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ]
    }
  ],
  "presets": [
    { "name": "About hero" }
  ]
}
{% endschema %}

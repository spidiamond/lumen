{{ 'shop.css' | asset_url | stylesheet_tag }}

{% render 'shop-main',
  lead: section.settings.heading_lead,
  accent: section.settings.heading_accent,
  banner: section.settings.banner,
  banner_position: section.settings.banner_position,
  overlay: section.settings.overlay,
  show_label: section.settings.show_label,
  label: section.settings.label,
  section_id: section.id,
  shop_collection: collection
%}

{% schema %}
{
  "name": "Shop",
  "tag": "div",
  "class": "section-shop",
  "enabled_on": {
    "templates": ["collection", "page"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Banner"
    },
    {
      "type": "image_picker",
      "id": "banner",
      "label": "Banner image",
      "info": "Leave empty to use the theme's landscape banner."
    },
    {
      "type": "text",
      "id": "heading_lead",
      "label": "Heading",
      "default": "Discover"
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "Heading, italic",
      "default": "Skincare Essentials"
    },
    {
      "type": "range",
      "id": "overlay",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "%",
      "label": "Banner overlay",
      "default": 26
    },
    {
      "type": "select",
      "id": "banner_position",
      "label": "Banner image position",
      "default": "center 42%",
      "options": [
        { "value": "center center", "label": "Center" },
        { "value": "center 30%", "label": "Upper center" },
        { "value": "center 42%", "label": "Slightly above center" },
        { "value": "center top", "label": "Top" },
        { "value": "center bottom", "label": "Bottom" }
      ]
    },
    {
      "type": "header",
      "content": "Products"
    },
    {
      "type": "checkbox",
      "id": "show_label",
      "label": "Show label",
      "default": false
    },
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "All essentials"
    }
  ]
}
{% endschema %}

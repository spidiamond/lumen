{% comment %}
  Contact uses the page title and body. Shop and About are real pages in
  admin, so their designed layouts render here on the normal page URL.
{% endcomment %}

{%- if page.handle == 'shop' -%}
  {{ 'shop.css' | asset_url | stylesheet_tag }}
  {% render 'shop-main',
    lead: 'Discover',
    accent: 'Skincare Essentials',
    banner_position: 'center 42%',
    overlay: 26,
    show_label: false,
    label: 'All essentials',
    section_id: 'page-shop'
  %}
{%- elsif page.handle == 'about' -%}
  {% render 'about-page' %}
{%- else -%}
  <h1>{{ page.title }}</h1>
  {{ page.content }}
{%- endif -%}

{% schema %}
{
  "name": "t:general.page",
  "settings": []
}
{% endschema %}

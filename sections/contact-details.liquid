{% render 'contact-assets' %}

{%- liquid
  assign has_email = false
  assign has_care = false
  assign has_social = false
  if section.settings.email != blank
    assign has_email = true
  endif
  if section.settings.response != blank or section.settings.hours != blank or section.settings.care_note != blank
    assign has_care = true
  endif
  if section.settings.instagram != blank or section.settings.facebook != blank or section.settings.youtube != blank or section.settings.tiktok != blank
    assign has_social = true
  endif
-%}

{%- if has_email or has_care or has_social -%}
  <section class="contact-details full-width" aria-labelledby="ContactDetails-{{ section.id }}">
    <div class="contact-details__inner">
      {%- if section.settings.heading != blank -%}
        <h2 class="contact-details__heading" id="ContactDetails-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}

      <ul class="contact-details__list" role="list" data-contact-watch>
        {%- if has_email -%}
          <li class="contact-detail" data-contact-item>
            <p class="contact-kicker">{{ section.settings.email_label | escape }}</p>
            <a class="contact-detail__value" href="mailto:{{ section.settings.email | escape }}">{{ section.settings.email | escape }}</a>
          </li>
        {%- endif -%}

        {%- if has_care -%}
          <li class="contact-detail" data-contact-item>
            <p class="contact-kicker">{{ section.settings.care_label | escape }}</p>
            {%- if section.settings.response != blank -%}
              <p class="contact-detail__value">{{ section.settings.response | escape }}</p>
            {%- endif -%}
            {%- if section.settings.hours != blank -%}
              <p class="contact-detail__meta">{{ section.settings.hours | escape }}</p>
            {%- endif -%}
            {%- if section.settings.care_note != blank -%}
              <p class="contact-detail__meta">{{ section.settings.care_note | escape }}</p>
            {%- endif -%}
          </li>
        {%- endif -%}

        {%- if has_social -%}
          <li class="contact-detail" data-contact-item>
            <p class="contact-kicker">{{ section.settings.social_label | escape }}</p>
            <ul class="contact-detail__socials" role="list">
              {%- if section.settings.instagram != blank -%}
                <li><a class="contact-detail__link" href="{{ section.settings.instagram }}" target="_blank" rel="noopener">Instagram</a></li>
              {%- endif -%}
              {%- if section.settings.facebook != blank -%}
                <li><a class="contact-detail__link" href="{{ section.settings.facebook }}" target="_blank" rel="noopener">Facebook</a></li>
              {%- endif -%}
              {%- if section.settings.youtube != blank -%}
                <li><a class="contact-detail__link" href="{{ section.settings.youtube }}" target="_blank" rel="noopener">YouTube</a></li>
              {%- endif -%}
              {%- if section.settings.tiktok != blank -%}
                <li><a class="contact-detail__link" href="{{ section.settings.tiktok }}" target="_blank" rel="noopener">TikTok</a></li>
              {%- endif -%}
            </ul>
          </li>
        {%- endif -%}
      </ul>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Contact information",
  "tag": "div",
  "class": "section-contact",
  "enabled_on": { "templates": ["page"] },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Reach us directly"
    },
    {
      "type": "text",
      "id": "email_label",
      "label": "Email label",
      "default": "Email"
    },
    {
      "type": "text",
      "id": "email",
      "label": "Email address",
      "info": "Leave empty to hide."
    },
    {
      "type": "text",
      "id": "care_label",
      "label": "Care label",
      "default": "Customer care"
    },
    {
      "type": "text",
      "id": "response",
      "label": "Response time",
      "info": "Leave empty to hide."
    },
    {
      "type": "text",
      "id": "hours",
      "label": "Support hours",
      "info": "Leave empty to hide."
    },
    {
      "type": "textarea",
      "id": "care_note",
      "label": "Additional detail",
      "info": "Leave empty to hide."
    },
    {
      "type": "text",
      "id": "social_label",
      "label": "Social label",
      "default": "Social"
    },
    {
      "type": "url",
      "id": "instagram",
      "label": "Instagram"
    },
    {
      "type": "url",
      "id": "facebook",
      "label": "Facebook"
    },
    {
      "type": "url",
      "id": "youtube",
      "label": "YouTube"
    },
    {
      "type": "url",
      "id": "tiktok",
      "label": "TikTok"
    }
  ],
  "presets": [
    { "name": "Contact information" }
  ]
}
{% endschema %}
